{
  "name": "@cliniq/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:up": "node scripts/run-migration.mjs up",
    "migrate:down": "node scripts/run-migration.mjs down"
  },
  "dependencies": {
    "@cliniq/config": "workspace:*",
    "@cliniq/contracts": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "fastify": "^5.6.1",
    "ioredis": "^5.6.1",
    "pg": "^8.16.3",
    "pino": "^9.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "eslint": "^9.39.1",
    "node-pg-migrate": "^8.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.14"
  }
}
